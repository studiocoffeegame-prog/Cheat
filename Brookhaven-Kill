-- LOGIQUE PRINCIPALE
------------------------------------------------------------

local function executerAction(cible, statusLabel, etapeLabel)
	if enAction then
		setStatus(statusLabel, "⚠️ Déjà en cours!", Color3.fromRGB(255, 200, 50))
		return
	end

	if not cible then
		setStatus(statusLabel, "❌ Aucune cible!", Color3.fromRGB(255, 50, 50))
		return
	end

	if not cible.Character or not getCibleHRP(cible) then
		setStatus(statusLabel, "❌ Cible sans personnage!", Color3.fromRGB(255, 50, 50))
		return
	end

	----------------------------------------------------
	-- CHECK : Si le joueur est DEJA assis → ABANDON
	----------------------------------------------------
	if estDejaAssis(cible) then
		setStatus(statusLabel, "🚫 ABANDON - " .. cible.Name .. " est déjà assis!", Color3.fromRGB(255, 80, 80))
		setEtape(etapeLabel,
			"🚫 ABANDON\n"
			.. "━━━━━━━━━━━━━━━━\n"
			.. "❌ " .. cible.Name .. " est déjà assis\n"
			.. "❌ Impossible de le piéger\n"
			.. "💡 Attends qu'il se lève\n"
			.. "💡 Puis relance l'action"
		)
		return
	end

	enAction = true
	stopAction = false

	----------------------------------------------------
	-- ETAPE 1 : Sauvegarder position
	----------------------------------------------------
	setEtape(etapeLabel,
		"📌 ÉTAPE 1 - SAUVEGARDE\n"
		.. "━━━━━━━━━━━━━━━━\n"
		.. "📍 Sauvegarde position..."
	)

	local myChar = LocalPlayer.Character
	if myChar and myChar:FindFirstChild("HumanoidRootPart") then
		positionInitiale = myChar.HumanoidRootPart.Position
	end

	setStatus(statusLabel, "📍 Position sauvegardée", Color3.fromRGB(100, 200, 255))
	setEtape(etapeLabel,
		"📌 ÉTAPE 1 ✅\n"
		.. "━━━━━━━━━━━━━━━━\n"
		.. "📍 " .. math.floor(positionInitiale.X) .. ", " .. math.floor(positionInitiale.Y) .. ", " .. math.floor(positionInitiale.Z)
	)
	task.wait(0.3)

	if stopAction then
		enAction = false
		return
	end

	----------------------------------------------------
	-- ETAPE 2 : TP zone attente
	----------------------------------------------------
	setEtape(etapeLabel,
		"➡️ ÉTAPE 2 - TP ATTENTE\n"
		.. "━━━━━━━━━━━━━━━━\n"
		.. "📍 → " .. COORD_ATTENTE.X .. ", " .. COORD_ATTENTE.Y .. ", " .. COORD_ATTENTE.Z
	)
	setStatus(statusLabel, "➡️ TP zone attente...", Color3.fromRGB(100, 200, 255))

	tp(COORD_ATTENTE)
	task.wait(0.5)

	if stopAction then
		if positionInitiale then tp(positionInitiale) end
		enAction = false
		return
	end

	----------------------------------------------------
	-- ETAPE 3 : Attendre Couch
	----------------------------------------------------
	local t = 0
	local tMax = 180

	while not avoirCouch() and t < tMax and not stopAction do
		task.wait(0.4)
		t = t + 0.4
		local d = string.rep(".", math.floor(t) % 4)

		setStatus(statusLabel, "⏳ Attente Couch" .. d .. " (" .. math.floor(t) .. "s)", Color3.fromRGB(255, 200, 50))
		setEtape(etapeLabel,
			"📦 ÉTAPE 3 - ATTENTE COUCH\n"
			.. "━━━━━━━━━━━━━━━━\n"
			.. "⏳ " .. math.floor(t) .. "s / " .. tMax .. "s\n"
			.. "📦 Recherche dans inventaire...\n"
			.. "🔍 Couch non trouvé"
		)

		-- RE-CHECK : si la cible s'est assise entre-temps → abandon
		if estDejaAssis(cible) then
			setStatus(statusLabel, "🚫 ABANDON - " .. cible.Name .. " s'est assis!", Color3.fromRGB(255, 80, 80))
			if positionInitiale then tp(positionInitiale) end
			enAction = false
			return
		end
	end

	if stopAction then
		if positionInitiale then tp(positionInitiale) end
		enAction = false
		return
	end

	if not avoirCouch() then
		setStatus(statusLabel, "❌ Timeout Couch!", Color3.fromRGB(255, 50, 50))
		if positionInitiale then tp(positionInitiale) end
		enAction = false
		return
	end

	setStatus(statusLabel, "✅ Couch obtenu!", Color3.fromRGB(50, 255, 50))
	setEtape(etapeLabel, "📦 ÉTAPE 3 ✅\n━━━━━━━━━━━━━━━━\n✅ Couch trouvé!")
	task.wait(0.2)

	----------------------------------------------------
	-- ETAPE 4 : Équiper Couch
	----------------------------------------------------
	setEtape(etapeLabel,
		"🛋️ ÉTAPE 4 - ÉQUIPEMENT\n"
		.. "━━━━━━━━━━━━━━━━\n"
		.. "🛋️ Équipement Couch..."
	)

	equiperCouch()
	task.wait(0.3)

	if not couchEstEquipe() then
		equiperCouch()
		task.wait(0.2)
	end

	-- RE-CHECK avant de spam
	if estDejaAssis(cible) then
		setStatus(statusLabel, "🚫 ABANDON - " .. cible.Name .. " s'est assis!", Color3.fromRGB(255, 80, 80))
		desequiperCouch()
		if positionInitiale then tp(positionInitiale) end
		enAction = false
		return
	end

	setEtape(etapeLabel, "🛋️ ÉTAPE 4 ✅\n━━━━━━━━━━━━━━━━\n✅ Couch équipé!")
	task.wait(0.2)

	if stopAction then
		desequiperCouch()
		if positionInitiale then tp(positionInitiale) end
		enAction = false
		return
	end

	----------------------------------------------------
	-- ETAPE 5 : SPAM Couch sur la cible
	----------------------------------------------------
	setEtape(etapeLabel,
		"⚡ ÉTAPE 5 - SPAM\n"
		.. "━━━━━━━━━━━━━━━━\n"
		.. "🎯 Cible: " .. cible.Name .. "\n"
		.. "🔄 Lancement spam..."
	)

	local reussi = boucleSpamSurCible(cible, statusLabel, etapeLabel)

	if stopAction then
		desequiperCouch()
		if positionInitiale then tp(positionInitiale) end
		enAction = false
		setStatus(statusLabel, "⛔ Stoppé. Retour.", Color3.fromRGB(150, 150, 150))
		return
	end

	if not reussi then
		setStatus(statusLabel, "❌ Échec!", Color3.fromRGB(255, 50, 50))
		desequiperCouch()
		if positionInitiale then tp(positionInitiale) end
		enAction = false
		return
	end

	----------------------------------------------------
	-- ETAPE 6 : Cible assise → TP aux coordonnées RELACHER
	-- COUCH RESTE EN MAIN !
	----------------------------------------------------
	setEtape(etapeLabel,
		"🪑 ÉTAPE 6 - CIBLE ASSISE!\n"
		.. "━━━━━━━━━━━━━━━━\n"
		.. "✅ " .. cible.Name .. " est sur le Couch!\n"
		.. "🛋️ Couch EN MAIN\n"
		.. "➡️ TP vers zone de relâche..."
	)
	setStatus(statusLabel, "🪑 ASSIS! TP avec Couch en main...", Color3.fromRGB(50, 255, 100))
	task.wait(0.2)

	-- TP avec Couch EN MAIN (cible reste assise)
	tp(COORD_RELACHER)
	task.wait(0.5)

	setEtape(etapeLabel,
		"📍 ÉTAPE 6 ✅\n"
		.. "━━━━━━━━━━━━━━━━\n"
		.. "📍 Arrivé: -337.55, 52.91, -454.94\n"
		.. "🪑 " .. cible.Name .. " toujours assis\n"
		.. "🛋️ Couch toujours en main"
	)
	task.wait(0.3)

	----------------------------------------------------
	-- ETAPE 7 : MAINTENANT on lâche le Couch
	----------------------------------------------------
	setEtape(etapeLabel,
		"📦 ÉTAPE 7 - RELÂCHE\n"
		.. "━━━━━━━━━━━━━━━━\n"
		.. "🛋️ Déséquipement Couch...\n"
		.. "📦 → Inventaire"
	)
	setStatus(statusLabel, "📦 Relâche du Couch...", Color3.fromRGB(255, 200, 50))

	desequiperCouch()
	task.wait(0.5)

	setEtape(etapeLabel,
		"📦 ÉTAPE 7 ✅\n"
		.. "━━━━━━━━━━━━━━━━\n"
		.. "✅ Couch lâché\n"
		.. "🪑 " .. cible.Name .. " relâché ici"
	)

	----------------------------------------------------
	-- ETAPE 8 : Retour position initiale
	----------------------------------------------------
	setEtape(etapeLabel,
		"🏠 ÉTAPE 8 - RETOUR\n"
		.. "━━━━━━━━━━━━━━━━\n"
		.. "🏠 TP position de départ..."
	)
	setStatus(statusLabel, "🏠 Retour...", Color3.fromRGB(150, 255, 150))
	task.wait(0.5)

	if positionInitiale then
		tp(positionInitiale)
	end

	task.wait(0.5)

	setEtape(etapeLabel,
		"✅ TERMINÉ!\n"
		.. "━━━━━━━━━━━━━━━━\n"
		.. "🎯 " .. cible.Name .. " piégé!\n"
		.. "📍 Relâché à: -337.55, 52.91, -454.94\n"
		.. "🏠 Retour effectué\n"
		.. "\n💡 Prêt pour une nouvelle cible"
	)
	setStatus(statusLabel, "✅ " .. cible.Name .. " piégé et relâché! Prêt.", Color3.fromRGB(50, 255, 50))

	joueurCible = nil
	enAction = false
end

------------------------------------------------------------
-- LISTE JOUEURS
------------------------------------------------------------

local function rafraichirListe(scrollFrame, statusLabel)
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	local count = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			count = count + 1

			local btn = Instance.new("TextButton")
			btn.Name = "P_" .. player.Name
			btn.Size = UDim2.new(1, -8, 0, 34)
			btn.BackgroundColor3 = Color3.fromRGB(28, 28, 42)
			btn.BorderSizePixel = 0
			btn.Font = Enum.Font.GothamSemibold
			btn.TextSize = 11
			btn.TextColor3 = Color3.fromRGB(210, 210, 210)
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.Parent = scrollFrame

			local assis = estDejaAssis(player)
			local sitIcon = assis and " 🪑 ASSIS" or " ✅ DEBOUT"
			local sitColor = assis and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(100, 255, 100)

			btn.Text = "  👤 " .. player.DisplayName .. " (@" .. player.Name .. ")" .. sitIcon

			local bc = Instance.new("UICorner")
			bc.CornerRadius = UDim.new(0, 6)
			bc.Parent = btn

			btn.MouseEnter:Connect(function()
				if joueurCible ~= player then
					btn.BackgroundColor3 = Color3.fromRGB(42, 42, 65)
				end
			end)
			btn.MouseLeave:Connect(function()
				if joueurCible ~= player then
					btn.BackgroundColor3 = Color3.fromRGB(28, 28, 42)
				end
			end)

			btn.MouseButton1Click:Connect(function()
				for _, c in ipairs(scrollFrame:GetChildren()) do
					if c:IsA("TextButton") then
						c.BackgroundColor3 = Color3.fromRGB(28, 28, 42)
						c.TextColor3 = Color3.fromRGB(210, 210, 210)
					end
				end

				-- Si déjà assis : avertissement
				if estDejaAssis(player) then
					setStatus(statusLabel, "⚠️ " .. player.Name .. " est assis! Action impossible.", Color3.fromRGB(255, 150, 50))
				end

				joueurCible = player
				btn.BackgroundColor3 = Color3.fromRGB(55, 20, 20)
				btn.TextColor3 = Color3.fromRGB(255, 100, 100)
				setStatus(statusLabel, "🎯 Cible: " .. player.DisplayName, Color3.fromRGB(255, 150, 100))
			end)
		end
	end

	local layout = scrollFrame:FindFirstChildOfClass("UIListLayout")
	if layout then
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
	end

	if count == 0 then
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(1, 0, 0, 40)
		lbl.BackgroundTransparency = 1
		lbl.Text = "Aucun autre joueur"
		lbl.TextColor3 = Color3.fromRGB(70, 70, 70)
		lbl.TextSize = 11
		lbl.Font = Enum.Font.Gotham
		lbl.Parent = scrollFrame
	end
end

------------------------------------------------------------
-- INIT
------------------------------------------------------------

local function init()
	local screenGui, mainFrame, scrollFrame, statusLabel, etapeLabel,
		closeBtn, refreshBtn, executeBtn, stopBtn, toggleBtn = creerInterface()

	local killTool = creerKillTool()

	local function setupKillTool(tool)
		tool.Activated:Connect(function()
			local mouse = LocalPlayer:GetMouse()
			local target = mouse.Target
			if target then
				local model = target:FindFirstAncestorOfClass("Model")
				if model then
					local p = Players:GetPlayerFromCharacter(model)
					if p and p ~= LocalPlayer then
						joueurCible = p
						setStatus(statusLabel, "🎯 " .. p.DisplayName .. " | Lancement!", Color3.fromRGB(255, 100, 50))
						task.spawn(function()
							executerAction(joueurCible, statusLabel, etapeLabel)
						end)
					end
				end
			end
		end)
	end

	setupKillTool(killTool)

	LocalPlayer.CharacterAdded:Connect(function()
		task.wait(1)
		killTool = creerKillTool()
		setupKillTool(killTool)
	end)

	rafraichirListe(scrollFrame, statusLabel)

	toggleBtn.MouseButton1Click:Connect(function()
		mainFrame.Visible = not mainFrame.Visible
	end)

	closeBtn.MouseButton1Click:Connect(function()
		mainFrame.Visible = false
	end)

	refreshBtn.MouseButton1Click:Connect(function()
		rafraichirListe(scrollFrame, statusLabel)
		setStatus(statusLabel, "🔄 Mis à jour!", Color3.fromRGB(100, 255, 100))
	end)

	executeBtn.MouseButton1Click:Connect(function()
		if joueurCible then
			task.spawn(function()
				executerAction(joueurCible, statusLabel, etapeLabel)
			end)
		else
			setStatus(statusLabel, "❌ Sélectionne un joueur!", Color3.fromRGB(255, 50, 50))
		end
	end)

	stopBtn.MouseButton1Click:Connect(function()
		if enAction then
			stopAction = true
			setStatus(statusLabel, "⛔ Arrêt...", Color3.fromRGB(255, 100, 50))
		else
			setStatus(statusLabel, "ℹ️ Rien en cours.", Color3.fromRGB(120, 120, 120))
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.F6 then
			mainFrame.Visible = not mainFrame.Visible
		end
	end)

	Players.PlayerAdded:Connect(function()
		task.wait(1)
		rafraichirListe(scrollFrame, statusLabel)
	end)

	Players.PlayerRemoving:Connect(function(p)
		task.wait(0.3)
		if joueurCible == p then
			joueurCible = nil
			stopAction = true
		end
		rafraichirListe(scrollFrame, statusLabel)
	end)

	-- Auto refresh statut assis
	task.spawn(function()
		while true do
			task.wait(2)
			for _, child in ipairs(scrollFrame:GetChildren()) do
				if child:IsA("TextButton") and child.Name:sub(1, 2) == "P_" then
					local pName = child.Name:sub(3)
					local p = Players:FindFirstChild(pName)
					if p then
						local assis = estDejaAssis(p)
						local sitIcon = assis and " 🪑 ASSIS" or " ✅ DEBOUT"
						local sel = joueurCible == p and " ◄" or ""
						child.Text = "  👤 " .. p.DisplayName .. " (@" .. p.Name .. ")" .. sitIcon .. sel
					end
				end
			end
		end
	end)

	setStatus(statusLabel, "✅ Panel v4 chargé! [F6]", Color3.fromRGB(100, 255, 100))
	print("[ADMIN PANEL v4] Chargé! F6 pour ouvrir.")
end

init()
