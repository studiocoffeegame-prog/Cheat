local function trouverTousLesSeats()
	local couch = getCouchTool()
	if not couch then return {} end
	local seats = {}
	local function chercher(parent)
		for _, child in ipairs(parent:GetChildren()) do
			if child:IsA("Seat") or child:IsA("VehicleSeat") then
				table.insert(seats, child)
			end
			chercher(child)
		end
	end
	chercher(couch)
	return seats
end

local function cibleSurSeat(cible)
	if not cible or not cible.Character then return false end
	local hum = cible.Character:FindFirstChildOfClass("Humanoid")
	if not hum or not hum.Sit then return false end
	local seats = trouverTousLesSeats()
	for _, seat in ipairs(seats) do
		if seat.Occupant then
			local oc = seat.Occupant.Parent
			if oc then
				local op = Players:GetPlayerFromCharacter(oc)
				if op == cible then return true end
			end
		end
		if hum.SeatPart == seat then return true end
	end
	return false
end

local function spamTool()
	local c = LocalPlayer.Character
	if not c then return end
	local couch = c:FindFirstChild("Couch")
	if couch and couch:IsA("Tool") then couch:Activate() end
end

-- Chercher un joueur par nom partiel (comme HD Admin)
local function trouverJoueurParNom(nom)
	nom = nom:lower()
	local meilleur = nil
	local meilleurScore = math.huge

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local displayLower = p.DisplayName:lower()
			local nameLower = p.Name:lower()

			-- Match exact
			if nameLower == nom or displayLower == nom then
				return p
			end

			-- Match partiel début
			if nameLower:sub(1, #nom) == nom then
				if #nameLower < meilleurScore then
					meilleur = p
					meilleurScore = #nameLower
				end
			elseif displayLower:sub(1, #nom) == nom then
				if #displayLower < meilleurScore then
					meilleur = p
					meilleurScore = #displayLower
				end
			end
		end
	end

	return meilleur
end

-- Envoyer un message dans le chat
local function envoyerChat(message)
	pcall(function()
		-- TextChatService (nouveau système)
		local channel = TextChatService:FindFirstChild("TextChannels")
		if channel then
			local rbxGeneral = channel:FindFirstChild("RBXGeneral")
			if rbxGeneral then
				rbxGeneral:SendAsync(message)
				return
			end
		end
	end)

	pcall(function()
		-- Ancien système
		local chatService = game:GetService("Chat")
		local character = LocalPlayer.Character
		if character and character:FindFirstChild("Head") then
			chatService:Chat(character.Head, message, Enum.ChatColor.White)
		end
	end)

	pcall(function()
		StarterGui:SetCore("ChatMakeSystemMessage", {
			Text = "[Admin] " .. message,
			Color = Color3.fromRGB(255, 200, 50),
			Font = Enum.Font.GothamBold,
			TextSize = 14,
