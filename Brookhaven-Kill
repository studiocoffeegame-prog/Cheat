-- COMMANDES CHAT
------------------------------------------------------------

local function setupChatCommands(statusLabel, etapeLabel)
	pcall(function()
		LocalPlayer.Chatted:Connect(function(message)
			local msg = message:lower()
			msg = msg:match("^%s*(.-)%s*$")

			if msg:sub(1, 1) ~= CONFIG.PREFIX then return end

			local cmd = msg:sub(2)

			if cmd == "stop" then
				stopAction = true
				stopAutoKill = true
				autoKillActif = false
				setStatus(statusLabel, "STOP via chat.", Color3.fromRGB(255, 100, 50))
				return
			end

			if cmd == "goodbye" then
				goodbyeActif = not goodbyeActif
				local state = goodbyeActif and "ON" or "OFF"
				setStatus(statusLabel, "Goodbye: " .. state, Color3.fromRGB(255, 200, 100))
				return
			end

			if cmd == "kill all" then
				if not aLeGamepass and CONFIG.GAMEPASS_ID > 0 then
					afficherGamepassRequis()
					return
				end
				autoKillActif = true
				stopAutoKill = false
				setStatus(statusLabel, "AutoKill ALL via chat!", Color3.fromRGB(255, 100, 50))
				task.spawn(function()
					autoKillLoop(statusLabel, etapeLabel)
				end)
				return
			end

			if cmd:sub(1, 5) == "kill " then
				if not aLeGamepass and CONFIG.GAMEPASS_ID > 0 then
					afficherGamepassRequis()
					return
				end

				local args = cmd:sub(6)
				local noms = {}
				for nom in args:gmatch("%S+") do
					table.insert(noms, nom)
				end

				if #noms == 0 then
					setStatus(statusLabel, "Usage: ;kill nom", Color3.fromRGB(255, 50, 50))
					return
				end

				local joueursTrouves = {}
				local nonTrouves = {}

				for _, nom in ipairs(noms) do
					local p = trouverJoueurParNom(nom)
					if p then
						table.insert(joueursTrouves, p)
					else
						table.insert(nonTrouves, nom)
					end
				end

				if #nonTrouves > 0 then
					setStatus(statusLabel, "Non trouve: " .. table.concat(nonTrouves, ", "), Color3.fromRGB(255, 200, 50))
				end

				if #joueursTrouves > 0 then
					stopAction = false
					local names = {}
					for _, p in ipairs(joueursTrouves) do
						table.insert(names, p.Name)
					end
					setStatus(statusLabel, "Kill: " .. table.concat(names, ", "), Color3.fromRGB(255, 100, 50))
					task.spawn(function()
						enAction = true
						killMultiple(joueursTrouves, statusLabel, etapeLabel)
						enAction = false
					end)
				end
			end
		end)
	end)
end

