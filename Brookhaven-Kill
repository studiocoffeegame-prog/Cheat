			if humanoid then
				local desc = humanoid:FindFirstChildOfClass("HumanoidDescription")
				if desc then
					-- Essayer de jouer l'emote
					local anim = humanoid:FindFirstChildOfClass("Animator")
					if anim then
						-- Chercher l'emote dans les animations
						for _, v in ipairs(anim:GetPlayingAnimationTracks()) do
							-- stop existing
						end
					end
				end

				-- Essayer via le chat emote
				pcall(function()
					local channel = TextChatService:FindFirstChild("TextChannels")
					if channel then
