local function creerKillTool()
	local backpack = LocalPlayer:WaitForChild("Backpack")
	if backpack:FindFirstChild("Kill Tool") then return backpack:FindFirstChild("Kill Tool") end
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Kill Tool") then
		return LocalPlayer.Character:FindFirstChild("Kill Tool")
	end

	local tool = Instance.new("Tool")
	tool.Name = "Kill Tool"
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.ToolTip = "Clic sur joueur = piège Couch"

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(1, 1, 4)
	handle.BrickColor = BrickColor.new("Really red")
	handle.Material = Enum.Material.Neon
	handle.Parent = tool

	tool.Parent = backpack
	return tool
end

------------------------------------------------------------
-- UTILITAIRES
------------------------------------------------------------

local function setStatus(label, text, color)
	label.Text = "Statut: " .. text
	label.TextColor3 = color or Color3.fromRGB(200, 200, 200)
end

local function setEtape(label, text)
	label.Text = text
end

local function tp(position)
	local c = LocalPlayer.Character
	if c then
		local hrp = c:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = CFrame.new(position)
			return true
		end
	end
	return false
end

local function getCibleHRP(player)
	if player and player.Character then
		return player.Character:FindFirstChild("HumanoidRootPart")
	end
	return nil
end

-- Vérifier si un joueur est DEJA assis (peu importe où)
local function estDejaAssis(player)
	if player and player.Character then
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hum then return hum.Sit == true end
	end
	return false
end

-- Trouver le Couch tool
local function getCouchTool()
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp and bp:FindFirstChild("Couch") then return bp:FindFirstChild("Couch") end
	local c = LocalPlayer.Character
	if c and c:FindFirstChild("Couch") then return c:FindFirstChild("Couch") end
	return nil
end

local function avoirCouch()
	return getCouchTool() ~= nil
end

local function equiperCouch()
	local c = LocalPlayer.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if not hum then return false end

	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp and bp:FindFirstChild("Couch") then
		hum:EquipTool(bp:FindFirstChild("Couch"))
		return true
	end
	if c and c:FindFirstChild("Couch") then return true end
	return false
end

local function desequiperCouch()
	local c = LocalPlayer.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if hum then hum:UnequipTools() end
end

local function couchEstEquipe()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("Couch") ~= nil
end

-- Trouver TOUS les seats dans le Couch
local function trouverTousLesSeats()
	local couch = getCouchTool()
	if not couch then return {} end

	local seats = {}
	local function chercher(parent)
		for _, child in ipairs(parent:GetChildren()) do
			if child:IsA("Seat") or child:IsA("VehicleSeat") then
				table.insert(seats, child)
			end
			chercher(child)
		end
	end
	chercher(couch)
	return seats
end

-- Vérifier si la cible est assise sur UN des seats du Couch
local function cibleSurUnSeat(cible)
	if not cible or not cible.Character then return false end

	local hum = cible.Character:FindFirstChildOfClass("Humanoid")
	if not hum or not hum.Sit then return false end

	local seats = trouverTousLesSeats()
	for _, seat in ipairs(seats) do
		-- Via Occupant
		if seat.Occupant then
			local occChar = seat.Occupant.Parent
			if occChar then
				local occPlayer = Players:GetPlayerFromCharacter(occChar)
				if occPlayer == cible then return true end
			end
		end
		-- Via SeatPart
		if hum.SeatPart == seat then return true end
	end

	return false
end

-- Spam : activer le tool (simuler un clic)
local function spamActiverTool()
	local c = LocalPlayer.Character
	if not c then return end

	local couch = c:FindFirstChild("Couch")
	if not couch then return end

	-- Activer le tool
	if couch:IsA("Tool") then
		couch:Activate()
	end
end

------------------------------------------------------------
-- BOUCLE DE SPAM : positionner + spam tool sur la cible
------------------------------------------------------------

local function boucleSpamSurCible(cible, statusLabel, etapeLabel)
	local compteur = 0

	while not stopAction do
		-- Vérifier cible
		if not cible or not cible.Parent or not cible.Character then
			setStatus(statusLabel, "⚠️ Cible perdue!", Color3.fromRGB(255, 200, 50))
			return false
		end

		local cibleHRP = getCibleHRP(cible)
		if not cibleHRP then
			task.wait(0.2)
			compteur = compteur + 1
			continue
		end

		-- Vérifier si la cible s'est assise sur un seat du Couch
		if cibleSurUnSeat(cible) then
			setStatus(statusLabel, "✅ " .. cible.Name .. " ASSIS sur le Couch!", Color3.fromRGB(50, 255, 50))
			return true
		end

		-- Vérifier que Couch est toujours équipé
		if not couchEstEquipe() then
			equiperCouch()
			task.wait(0.05)
		end

		compteur = compteur + 1
		local ciblePos = cibleHRP.Position

		-- Se positionner SUR la cible
		local myChar = LocalPlayer.Character
		local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if myHRP then
			myHRP.CFrame = CFrame.new(ciblePos)
		end

		-- Positionner tous les seats du Couch sur la cible
		local seats = trouverTousLesSeats()
		for i, seat in ipairs(seats) do
			-- Décaler légèrement chaque seat pour couvrir plus de zone
			local offset = Vector3.new(0, -0.5 + (i - 1) * 0.2, 0)
			seat.CFrame = CFrame.new(ciblePos + offset)
		end

		-- Positionner le Handle aussi
		local couch = getCouchTool()
		if couch then
			local handle = couch:FindFirstChild("Handle")
			if handle then
				handle.CFrame = CFrame.new(ciblePos + Vector3.new(0, -0.5, 0))
			end
		end

		-- SPAM : activer le tool en continu
		spamActiverTool()

		-- Affichage
		local dots = string.rep(".", compteur % 4)
		local nbSeats = #seats

		setStatus(statusLabel,
			"🔄 Spam Couch sur " .. cible.Name .. dots .. " (" .. compteur .. "x) | " .. nbSeats .. " seats",
			Color3.fromRGB(100, 200, 255)
		)

		setEtape(etapeLabel,
			"⚡ ÉTAPE 5 - SPAM ACTIF\n"
			.. "━━━━━━━━━━━━━━━━\n"
			.. "🎯 Cible: " .. cible.Name .. "\n"
			.. "📍 " .. math.floor(ciblePos.X) .. ", " .. math.floor(ciblePos.Y) .. ", " .. math.floor(ciblePos.Z) .. "\n"
			.. "🔄 Spam #" .. compteur .. "\n"
			.. "🪑 Seats: " .. nbSeats .. " positionnés\n"
			.. "⏳ Attente assise..."
		)

		task.wait(0.05) -- Spam très rapide : 20x par seconde
	end

	return false
end

