-- KILL MULTIPLE (file d'attente)
------------------------------------------------------------

local function killMultiple(joueurs, statusLabel, etapeLabel)
	local total = #joueurs
	local kills = 0

	for i, cible in ipairs(joueurs) do
		if stopAction or stopAutoKill then break end

		setEtape(etapeLabel,
			"📋 FILE D'ATTENTE\n"
			.. "━━━━━━━━━━━━━━━\n"
			.. "🎯 " .. i .. "/" .. total .. " : " .. cible.Name .. "\n"
			.. "✅ Kills: " .. kills .. "\n"
			.. "⏳ En cours..."
		)

		local ok = killJoueur(cible, statusLabel, etapeLabel)
		if ok then kills = kills + 1 end

		if i < total and not stopAction then
			setStatus(statusLabel, "⏳ Prochain dans 2s...", Color3.fromRGB(200, 200, 100))
			task.wait(2)
		end
	end

	setEtape(etapeLabel,
		"📋 FILE TERMINÉE\n"
		.. "━━━━━━━━━━━━━━━\n"
		.. "✅ " .. kills .. "/" .. total .. " kills réussis\n"
		.. "🏠 Terminé!"
	)
	setStatus(statusLabel, "✅ " .. kills .. "/" .. total .. " kills! Prêt.", Color3.fromRGB(50, 255, 50))
end

------------------------------------------------------------
-- AUTO KILL
------------------------------------------------------------

local function autoKillLoop(statusLabel, etapeLabel)
	while autoKillActif and not stopAutoKill do
		-- Trouver un joueur aléatoire non assis
		local candidats = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and not estDejaAssis(p) and p.Character and getCibleHRP(p) then
				table.insert(candidats, p)
			end
		end

		if #candidats == 0 then
			setStatus(statusLabel, "🔄 AutoKill: Aucun joueur dispo. Attente...", Color3.fromRGB(255, 200, 50))
			setEtape(etapeLabel, "🔄 AUTO KILL\n━━━━━━━━━━━━━━━\n⏳ Aucun joueur disponible\n🔍 Recherche...")
			task.wait(3)
			continue
		end

		-- Choisir aléatoirement
		local cible = candidats[math.random(1, #candidats)]
		setStatus(statusLabel, "🔄 AutoKill → " .. cible.Name, Color3.fromRGB(255, 150, 50))

		stopAction = false
		enAction = true
		local ok = killJoueur(cible, statusLabel, etapeLabel)
		enAction = false

		if ok then
			setEtape(etapeLabel,
				"🔄 AUTO KILL\n━━━━━━━━━━━━━━━\n✅ " .. cible.Name .. " kill!\n⏳ Prochain dans 3s..."
			)
		end

		if autoKillActif and not stopAutoKill then
			task.wait(3)
		end
	end

	setStatus(statusLabel, "⛔ AutoKill arrêté.", Color3.fromRGB(150, 150, 150))
end

