	l.TextColor3 = c or Color3.fromRGB(200, 200, 200)
end

local function setEtape(l, t)
	l.Text = tostring(t)
end

local function tpJoueur(pos)
	local c = LocalPlayer.Character
	if c then
		local h = c:FindFirstChild("HumanoidRootPart")
		if h then
			h.CFrame = CFrame.new(pos)
			return true
		end
	end
	return false
end

local function estDejaAssis(p)
	if p and p.Character then
		local h = p.Character:FindFirstChildOfClass("Humanoid")
		if h then return h.Sit == true end
	end
	return false
end

local function getCouchTool()
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp and bp:FindFirstChild("Couch") then return bp:FindFirstChild("Couch") end
	local c = LocalPlayer.Character
	if c and c:FindFirstChild("Couch") then return c:FindFirstChild("Couch") end
	return nil
end

local function avoirCouch()
	return getCouchTool() ~= nil
end

local function equiperCouch()
	local c = LocalPlayer.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if not h then return false end
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if bp and bp:FindFirstChild("Couch") then
		h:EquipTool(bp:FindFirstChild("Couch"))
		return true
	end
	if c and c:FindFirstChild("Couch") then return true end
	return false
end

local function desequiperCouch()
	local c = LocalPlayer.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if h then h:UnequipTools() end
end

local function couchEquipe()
	local c = LocalPlayer.Character
	return c and c:FindFirstChild("Couch") ~= nil
end

local function getCibleHRP(p)
	if p and p.Character then return p.Character:FindFirstChild("HumanoidRootPart") end
	return nil
end

local function trouverTousLesSeats()
	local couch = getCouchTool()
	if not couch then return {} end
	local seats = {}
	local function chercher(parent)
		for _, child in ipairs(parent:GetChildren()) do
			if child:IsA("Seat") or child:IsA("VehicleSeat") then
				table.insert(seats, child)
			end
			chercher(child)
		end
	end
	chercher(couch)
	return seats
end

local function cibleSurSeat(cible)
	if not cible or not cible.Character then return false end
	local hum = cible.Character:FindFirstChildOfClass("Humanoid")
	if not hum or not hum.Sit then return false end
	local seats = trouverTousLesSeats()
	for _, seat in ipairs(seats) do
		if seat.Occupant then
			local oc = seat.Occupant.Parent
			if oc then
				local op = Players:GetPlayerFromCharacter(oc)
				if op == cible then return true end
			end
		end
		if hum.SeatPart == seat then return true end
	end
	return false
end

local function spamTool()
	local c = LocalPlayer.Character
	if not c then return end
	local couch = c:FindFirstChild("Couch")
	if couch and couch:IsA("Tool") then
		couch:Activate()
	end
end

local function trouverJoueurParNom(nom)
	nom = nom:lower()
	local meilleur = nil
	local meilleurScore = math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local dL = p.DisplayName:lower()
			local nL = p.Name:lower()
			if nL == nom or dL == nom then return p end
			if nL:sub(1, #nom) == nom then
				if #nL < meilleurScore then
					meilleur = p
					meilleurScore = #nL
				end
			elseif dL:sub(1, #nom) == nom then
				if #dL < meilleurScore then
					meilleur = p
					meilleurScore = #dL
				end
			end
		end
	end
	return meilleur
end

local function envoyerChat(message)
	pcall(function()
		local channel = TextChatService:FindFirstChild("TextChannels")
		if channel then
			local rbx = channel:FindFirstChild("RBXGeneral")
			if rbx then
				rbx:SendAsync(tostring(message))
			end
		end
	end)
end

local function jouerEmote(emoteName)
	pcall(function()
		local channel = TextChatService:FindFirstChild("TextChannels")
		if channel then
			local rbx = channel:FindFirstChild("RBXGeneral")
			if rbx then
				rbx:SendAsync("/e " .. tostring(emoteName))
			end
		end
	end)
end

