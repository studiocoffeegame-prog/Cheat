local function verifierGamepass()
	if CONFIG.GAMEPASS_ID == 0 then
		aLeGamepass = true
		return true
	end

	local success, hasPass = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(LocalPlayer.UserId, CONFIG.GAMEPASS_ID)
	end)

	if success then
		aLeGamepass = hasPass
		return hasPass
	end

	aLeGamepass = false
	return false
end

