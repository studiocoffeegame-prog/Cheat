local function rafraichirListe(scrollFrame, statusLabel)
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	local count = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			count = count + 1

			local btn = Instance.new("TextButton")
			btn.Name = "P_" .. player.Name
			btn.Size = UDim2.new(1, -6, 0, 30)
			btn.BackgroundColor3 = Color3.fromRGB(24, 24, 38)
			btn.BorderSizePixel = 0
			btn.Font = Enum.Font.GothamSemibold
			btn.TextSize = 10
			btn.TextColor3 = Color3.fromRGB(200, 200, 200)
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.Parent = scrollFrame

			local assis = estDejaAssis(player)
			local si = assis and " [ASSIS]" or " [DEBOUT]"
			local selected = joueursSelectionnes[player.Name] and " <" or ""
			btn.Text = "  " .. player.DisplayName .. " (@" .. player.Name .. ")" .. si .. selected

			local bc = Instance.new("UICorner")
			bc.CornerRadius = UDim.new(0, 5)
			bc.Parent = btn

			if joueursSelectionnes[player.Name] then
				btn.BackgroundColor3 = Color3.fromRGB(50, 20, 20)
				btn.TextColor3 = Color3.fromRGB(255, 120, 120)
			end

			btn.MouseEnter:Connect(function()
				if not joueursSelectionnes[player.Name] then
					btn.BackgroundColor3 = Color3.fromRGB(38, 38, 58)
				end
			end)

			btn.MouseLeave:Connect(function()
				if not joueursSelectionnes[player.Name] then
					btn.BackgroundColor3 = Color3.fromRGB(24, 24, 38)
				end
			end)

			btn.MouseButton1Click:Connect(function()
				if joueursSelectionnes[player.Name] then
					joueursSelectionnes[player.Name] = nil
					btn.BackgroundColor3 = Color3.fromRGB(24, 24, 38)
					btn.TextColor3 = Color3.fromRGB(200, 200, 200)
				else
					joueursSelectionnes[player.Name] = true
					btn.BackgroundColor3 = Color3.fromRGB(50, 20, 20)
					btn.TextColor3 = Color3.fromRGB(255, 120, 120)
				end

				local nb = 0
				for _ in pairs(joueursSelectionnes) do nb = nb + 1 end
				setStatus(statusLabel, tostring(nb) .. " joueur(s) selectionne(s)", Color3.fromRGB(255, 150, 100))

				local asi = estDejaAssis(player) and " [ASSIS]" or " [DEBOUT]"
				local sel = joueursSelectionnes[player.Name] and " <" or ""
				btn.Text = "  " .. player.DisplayName .. " (@" .. player.Name .. ")" .. asi .. sel
			end)
		end
	end

	local layout = scrollFrame:FindFirstChildOfClass("UIListLayout")
	if layout then
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
	end

	if count == 0 then
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(1, 0, 0, 30)
		lbl.BackgroundTransparency = 1
		lbl.Text = "Aucun joueur"
		lbl.TextColor3 = Color3.fromRGB(60, 60, 60)
		lbl.TextSize = 10
		lbl.Font = Enum.Font.Gotham
		lbl.Parent = scrollFrame
	end
end

local function getJoueursSelectionnes()
	local liste = {}
	for name, _ in pairs(joueursSelectionnes) do
		local p = Players:FindFirstChild(name)
		if p and p ~= LocalPlayer then
			table.insert(liste, p)
		end
	end
	return liste
end

