-- INIT
------------------------------------------------------------

local function init()
	verifierGamepass()
	demarrerAntiAFK()

	local screenGui, mainFrame, scrollFrame, statusLabel, etapeLabel,
		closeBtn, refreshBtn, executeBtn, killAllBtn, stopBtn, toggleBtn,
		goodbyeBtn, autoKillBtn = creerInterface()

	local killTool = creerKillTool()

	local function setupKillTool(tool)
		tool.Activated:Connect(function()
			if not aLeGamepass and CONFIG.GAMEPASS_ID > 0 then
				afficherGamepassRequis()
				return
			end
			local mouse = LocalPlayer:GetMouse()
			local target = mouse.Target
			if target then
				local model = target:FindFirstAncestorOfClass("Model")
				if model then
					local p = Players:GetPlayerFromCharacter(model)
					if p and p ~= LocalPlayer then
						setStatus(statusLabel, p.DisplayName .. " via Kill Tool!", Color3.fromRGB(255, 100, 50))
						stopAction = false
						task.spawn(function()
							enAction = true
							killJoueur(p, statusLabel, etapeLabel)
							enAction = false
						end)
					end
				end
			end
		end)
	end

	setupKillTool(killTool)

	LocalPlayer.CharacterAdded:Connect(function()
		task.wait(1)
		killTool = creerKillTool()
		setupKillTool(killTool)
	end)

	setupChatCommands(statusLabel, etapeLabel)
	rafraichirListe(scrollFrame, statusLabel)

	toggleBtn.MouseButton1Click:Connect(function()
		if not aLeGamepass and CONFIG.GAMEPASS_ID > 0 then
			afficherGamepassRequis()
			return
		end
		mainFrame.Visible = not mainFrame.Visible
	end)

	closeBtn.MouseButton1Click:Connect(function()
		mainFrame.Visible = false
	end)

	refreshBtn.MouseButton1Click:Connect(function()
		rafraichirListe(scrollFrame, statusLabel)
		setStatus(statusLabel, "Liste mise a jour!", Color3.fromRGB(100, 255, 100))
	end)

	executeBtn.MouseButton1Click:Connect(function()
		if not aLeGamepass and CONFIG.GAMEPASS_ID > 0 then
			afficherGamepassRequis()
			return
		end
		local sel = getJoueursSelectionnes()
		if #sel == 0 then
			setStatus(statusLabel, "Selectionne des joueurs!", Color3.fromRGB(255, 50, 50))
			return
		end
		stopAction = false
		task.spawn(function()
			enAction = true
			killMultiple(sel, statusLabel, etapeLabel)
			enAction = false
			joueursSelectionnes = {}
			rafraichirListe(scrollFrame, statusLabel)
		end)
	end)

	killAllBtn.MouseButton1Click:Connect(function()
		if not aLeGamepass and CONFIG.GAMEPASS_ID > 0 then
			afficherGamepassRequis()
			return
		end
		autoKillActif = true
		stopAutoKill = false
		stopAction = false
		autoKillBtn.Text = "AutoKill: ON"
		autoKillBtn.BackgroundColor3 = Color3.fromRGB(30, 80, 30)
		setStatus(statusLabel, "AutoKill ALL active!", Color3.fromRGB(255, 100, 50))
		task.spawn(function()
			autoKillLoop(statusLabel, etapeLabel)
			autoKillBtn.Text = "AutoKill: OFF"
			autoKillBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 60)
		end)
	end)

	stopBtn.MouseButton1Click:Connect(function()
		stopAction = true
		stopAutoKill = true
		autoKillActif = false
		autoKillBtn.Text = "AutoKill: OFF"
		autoKillBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 60)
		setStatus(statusLabel, "STOP!", Color3.fromRGB(255, 100, 50))
	end)

	goodbyeBtn.MouseButton1Click:Connect(function()
		goodbyeActif = not goodbyeActif
		if goodbyeActif then
			goodbyeBtn.Text = "Goodbye: ON"
			goodbyeBtn.BackgroundColor3 = Color3.fromRGB(30, 80, 30)
			setStatus(statusLabel, "Goodbye active!", Color3.fromRGB(100, 255, 100))
		else
			goodbyeBtn.Text = "Goodbye: OFF"
			goodbyeBtn.BackgroundColor3 = Color3.fromRGB(60, 30, 30)
			setStatus(statusLabel, "Goodbye desactive.", Color3.fromRGB(200, 200, 200))
		end
	end)

	autoKillBtn.MouseButton1Click:Connect(function()
		if not aLeGamepass and CONFIG.GAMEPASS_ID > 0 then
			afficherGamepassRequis()
			return
		end
		if autoKillActif then
			stopAutoKill = true
			autoKillActif = false
			autoKillBtn.Text = "AutoKill: OFF"
			autoKillBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 60)
			setStatus(statusLabel, "AutoKill OFF", Color3.fromRGB(200, 200, 200))
		else
			autoKillActif = true
			stopAutoKill = false
			stopAction = false
			autoKillBtn.Text = "AutoKill: ON"
			autoKillBtn.BackgroundColor3 = Color3.fromRGB(30, 80, 30)
			setStatus(statusLabel, "AutoKill ON!", Color3.fromRGB(255, 100, 50))
			task.spawn(function()
				autoKillLoop(statusLabel, etapeLabel)
				autoKillBtn.Text = "AutoKill: OFF"
				autoKillBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 60)
			end)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.F6 then
			if not aLeGamepass and CONFIG.GAMEPASS_ID > 0 then
				afficherGamepassRequis()
				return
			end
			mainFrame.Visible = not mainFrame.Visible
		end
	end)

	Players.PlayerAdded:Connect(function()
		task.wait(1)
		rafraichirListe(scrollFrame, statusLabel)
	end)

	Players.PlayerRemoving:Connect(function(p)
		task.wait(0.3)
		joueursSelectionnes[p.Name] = nil
		rafraichirListe(scrollFrame, statusLabel)
	end)

	task.spawn(function()
		while true do
			task.wait(3)
			for _, child in ipairs(scrollFrame:GetChildren()) do
				if child:IsA("TextButton") and child.Name:sub(1, 2) == "P_" then
					local pN = child.Name:sub(3)
					local p = Players:FindFirstChild(pN)
					if p then
						local asi = estDejaAssis(p) and " [ASSIS]" or " [DEBOUT]"
						local sel = joueursSelectionnes[pN] and " <" or ""
						child.Text = "  " .. p.DisplayName .. " (@" .. p.Name .. ")" .. asi .. sel
					end
				end
			end
		end
	end)

	if aLeGamepass or CONFIG.GAMEPASS_ID == 0 then
		setStatus(statusLabel, "Panel v5 charge! F6 | Anti-AFK actif", Color3.fromRGB(100, 255, 100))
	else
		setStatus(statusLabel, "Gamepass requis!", Color3.fromRGB(255, 80, 80))
	end

	print("[ADMIN PANEL v5] Charge! F6 pour ouvrir.")
end

