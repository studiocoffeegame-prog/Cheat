local function setupChatCommands(statusLabel, etapeLabel)
	-- Nouveau système TextChatService
	pcall(function()
		TextChatService.SendingMessage:Connect(function(msg)
			-- Ce event n'existe pas toujours, on utilise MessageReceived
		end)
	end)

	-- Utiliser l'event de chat du joueur
	pcall(function()
		LocalPlayer.Chatted:Connect(function(message)
			local msg = message:lower():gsub("^%s+", ""):gsub("%s+$", "")

			if not msg:sub(1, #CONFIG.PREFIX) == CONFIG.PREFIX then return end
			local cmd = msg:sub(#CONFIG.PREFIX + 1)

			-- ;stop
			if cmd == "stop" then
				stopAction = true
				stopAutoKill = true
				autoKillActif = false
				setStatus(statusLabel, "⛔ STOP via chat.", Color3.fromRGB(255, 100, 50))
				return
			end

			-- ;goodbye
			if cmd == "goodbye" then
				goodbyeActif = not goodbyeActif
				local state = goodbyeActif and "ON" or "OFF"
				setStatus(statusLabel, "👋 Goodbye: " .. state, Color3.fromRGB(255, 200, 100))
				return
			end

			-- ;kill all
			if cmd == "kill all" then
				if not aLeGamepass and CONFIG.GAMEPASS_ID > 0 then
					afficherGamepassRequis()
					return
				end

				autoKillActif = true
				stopAutoKill = false
				setStatus(statusLabel, "🔄 AutoKill ALL activé via chat!", Color3.fromRGB(255, 100, 50))
				task.spawn(function()
					autoKillLoop(statusLabel, etapeLabel)
				end)
				return
			end

			-- ;kill <nom1> <nom2> ...
			if cmd:sub(1, 5) == "kill " then
				if not aLeGamepass and CONFIG.GAMEPASS_ID > 0 then
					afficherGamepassRequis()
					return
				end

				local args = cmd:sub(6)
				local noms = {}
				for nom in args:gmatch("%S+") do
					table.insert(noms, nom)
				end

				if #noms == 0 then
					setStatus(statusLabel, "❌ ;kill <nom>", Color3.fromRGB(255, 50, 50))
					return
				end

				local joueursTrouvés = {}
				local nonTrouvés = {}

				for _, nom in ipairs(noms) do
					local p = trouverJoueurParNom(nom)
					if p then
						table.insert(joueursTrouvés, p)
					else
						table.insert(nonTrouvés, nom)
					end
				end

				if #nonTrouvés > 0 then
					setStatus(statusLabel, "⚠️ Non trouvé: " .. table.concat(nonTrouvés, ", "), Color3.fromRGB(255, 200, 50))
				end

				if #joueursTrouvés > 0 then
					stopAction = false
					local names = {}
					for _, p in ipairs(joueursTrouvés) do table.insert(names, p.Name) end
					setStatus(statusLabel, "💀 Kill: " .. table.concat(names, ", "), Color3.fromRGB(255, 100, 50))

					task.spawn(function()
						enAction = true
						killMultiple(joueursTrouvés, statusLabel, etapeLabel)
						enAction = false
					end)
				end

				return
			end
		end)
	end)
end

