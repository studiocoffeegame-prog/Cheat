local function boucleSpam(cible, statusLabel, etapeLabel)
	local compteur = 0
	while not stopAction do
		if not cible or not cible.Parent or not cible.Character then
			return false
		end

		local hrp = getCibleHRP(cible)
		if not hrp then
			task.wait(0.15)
			compteur = compteur + 1
			continue
		end

		if cibleSurSeat(cible) then
			return true
		end

		if estDejaAssis(cible) and not cibleSurSeat(cible) then
			setStatus(statusLabel, "Abandon: " .. cible.Name .. " assis ailleurs.", Color3.fromRGB(255, 80, 80))
			return false
		end

		if not couchEquipe() then
			equiperCouch()
			task.wait(0.03)
		end

		compteur = compteur + 1
		local pos = hrp.Position
		local myC = LocalPlayer.Character
		local myH = myC and myC:FindFirstChild("HumanoidRootPart")

		if myH then
			myH.CFrame = CFrame.new(pos)
		end

		local seats = trouverTousLesSeats()
		for i, seat in ipairs(seats) do
			local off = Vector3.new(0, -0.5 + (i - 1) * 0.15, 0)
			seat.CFrame = CFrame.new(pos + off)
		end

		local couch = getCouchTool()
		if couch then
			local handle = couch:FindFirstChild("Handle")
			if handle then
				handle.CFrame = CFrame.new(pos + Vector3.new(0, -0.5, 0))
			end
		end

		spamTool()

		if compteur % 10 == 0 then
			local nbSeats = #seats
			setStatus(statusLabel,
				"Spam " .. cible.Name .. " #" .. tostring(compteur) .. " | " .. tostring(nbSeats) .. " seats",
				Color3.fromRGB(100, 200, 255)
			)
			setEtape(etapeLabel,
				"SPAM ACTIF\n"
				.. "Cible: " .. cible.Name .. "\n"
				.. "X:" .. tostring(math.floor(pos.X))
				.. " Y:" .. tostring(math.floor(pos.Y))
				.. " Z:" .. tostring(math.floor(pos.Z)) .. "\n"
				.. "Spam #" .. tostring(compteur)
				.. " | Seats: " .. tostring(nbSeats) .. "\n"
				.. "Attente que la cible s assie..."
			)
		end

		task.wait(CONFIG.SPAM_INTERVAL)
	end
	return false
end

------------------------------------------------------------
-- KILL UN JOUEUR
------------------------------------------------------------

local function killJoueur(cible, statusLabel, etapeLabel)
	if not cible then return false end

	if estDejaAssis(cible) then
		setStatus(statusLabel, cible.Name .. " deja assis. Skip.", Color3.fromRGB(255, 80, 80))
		setEtape(etapeLabel, "SKIP: " .. cible.Name .. " deja assis")
		return false
	end

	if goodbyeActif then
		setStatus(statusLabel, "Goodbye " .. cible.Name .. "...", Color3.fromRGB(255, 200, 100))
		setEtape(etapeLabel, "GOODBYE\nCible: " .. cible.Name .. "\nWave + message...")
		faireGoodbye(cible)
		if stopAction then return false end
		if estDejaAssis(cible) then
			setStatus(statusLabel, cible.Name .. " assis pendant goodbye.", Color3.fromRGB(255, 80, 80))
			return false
		end
	end

	local myC = LocalPlayer.Character
	if myC and myC:FindFirstChild("HumanoidRootPart") then
		positionInitiale = myC.HumanoidRootPart.Position
	end

	setStatus(statusLabel, "TP attente...", Color3.fromRGB(100, 200, 255))
	setEtape(etapeLabel, "KILL: " .. cible.Name .. "\nTP zone attente...")
	tpJoueur(CONFIG.COORD_ATTENTE)
	task.wait(0.4)

	if stopAction then
		if positionInitiale then tpJoueur(positionInitiale) end
		return false
	end

	local t = 0
	while not avoirCouch() and t < 180 and not stopAction do
		task.wait(0.3)
		t = t + 0.3
		if math.floor(t) % 3 == 0 then
			setStatus(statusLabel, "Attente Couch... " .. tostring(math.floor(t)) .. "s", Color3.fromRGB(255, 200, 50))
			setEtape(etapeLabel,
				"ATTENTE COUCH\n"
				.. tostring(math.floor(t)) .. "s / 180s\n"
				.. "Couch non trouve dans inventaire..."
			)
		end
		if estDejaAssis(cible) then
			setStatus(statusLabel, cible.Name .. " assis. Abandon.", Color3.fromRGB(255, 80, 80))
			if positionInitiale then tpJoueur(positionInitiale) end
			return false
		end
	end

	if stopAction then
		if positionInitiale then tpJoueur(positionInitiale) end
		return false
	end

	if not avoirCouch() then
		setStatus(statusLabel, "Timeout Couch!", Color3.fromRGB(255, 50, 50))
		if positionInitiale then tpJoueur(positionInitiale) end
		return false
	end

	equiperCouch()
	task.wait(0.3)

	if estDejaAssis(cible) then
		desequiperCouch()
		if positionInitiale then tpJoueur(positionInitiale) end
		return false
	end

	setStatus(statusLabel, "Spam sur " .. cible.Name .. "...", Color3.fromRGB(100, 200, 255))
	local ok = boucleSpam(cible, statusLabel, etapeLabel)

	if stopAction then
		desequiperCouch()
		if positionInitiale then tpJoueur(positionInitiale) end
		return false
	end

	if not ok then
		desequiperCouch()
		if positionInitiale then tpJoueur(positionInitiale) end
		return false
	end

	setStatus(statusLabel, cible.Name .. " ASSIS! TP relache...", Color3.fromRGB(50, 255, 100))
	setEtape(etapeLabel,
		"ASSIS!\n"
		.. cible.Name .. " sur Couch\n"
		.. "TP relache avec Couch en main..."
	)
	task.wait(0.2)

	tpJoueur(CONFIG.COORD_RELACHER)
	task.wait(0.4)

	desequiperCouch()
	task.wait(0.3)

	setEtape(etapeLabel,
		"KILL REUSSI\n"
		.. "Cible: " .. cible.Name .. "\n"
		.. "Relache a: -337.55, 52.91, -454.94\n"
		.. "Couch lache"
	)

	if positionInitiale then tpJoueur(positionInitiale) end
	task.wait(0.3)

	setStatus(statusLabel, cible.Name .. " kill OK!", Color3.fromRGB(50, 255, 50))
	return true
end

------------------------------------------------------------
-- KILL MULTIPLE
------------------------------------------------------------

local function killMultiple(joueurs, statusLabel, etapeLabel)
	local total = #joueurs
	local kills = 0

	for i, cible in ipairs(joueurs) do
		if stopAction or stopAutoKill then break end

		setEtape(etapeLabel,
			"FILE D ATTENTE\n"
			.. tostring(i) .. "/" .. tostring(total) .. " : " .. cible.Name .. "\n"
			.. "Kills reussis: " .. tostring(kills) .. "\n"
			.. "En cours..."
		)

		local ok = killJoueur(cible, statusLabel, etapeLabel)
		if ok then kills = kills + 1 end

		if i < total and not stopAction then
			setStatus(statusLabel, "Prochain dans 2s...", Color3.fromRGB(200, 200, 100))
			task.wait(2)
		end
	end

	setEtape(etapeLabel,
		"FILE TERMINEE\n"
		.. tostring(kills) .. "/" .. tostring(total) .. " kills reussis\n"
		.. "Termine!"
	)
	setStatus(statusLabel, tostring(kills) .. "/" .. tostring(total) .. " kills! Pret.", Color3.fromRGB(50, 255, 50))
end

------------------------------------------------------------
-- AUTO KILL
------------------------------------------------------------

local function autoKillLoop(statusLabel, etapeLabel)
	while autoKillActif and not stopAutoKill do
		local candidats = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and not estDejaAssis(p) and p.Character and getCibleHRP(p) then
				table.insert(candidats, p)
			end
		end

		if #candidats == 0 then
			setStatus(statusLabel, "AutoKill: Aucun joueur dispo. Attente...", Color3.fromRGB(255, 200, 50))
			setEtape(etapeLabel, "AUTO KILL\nAucun joueur disponible\nRecherche...")
			task.wait(3)
			continue
		end

		local cible = candidats[math.random(1, #candidats)]
		setStatus(statusLabel, "AutoKill -> " .. cible.Name, Color3.fromRGB(255, 150, 50))

		stopAction = false
		enAction = true
		local ok = killJoueur(cible, statusLabel, etapeLabel)
		enAction = false

		if ok then
			setEtape(etapeLabel,
				"AUTO KILL\n"
				.. cible.Name .. " kill!\n"
				.. "Prochain dans 3s..."
			)
		end

		if autoKillActif and not stopAutoKill then
			task.wait(3)
		end
	end

	setStatus(statusLabel, "AutoKill arrete.", Color3.fromRGB(150, 150, 150))
end

