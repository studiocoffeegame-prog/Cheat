------------------------------------------------------------
-- SPAM BOUCLE SUR CIBLE
------------------------------------------------------------

local function boucleSpam(cible, statusLabel, etapeLabel)
	local compteur = 0

	while not stopAction do
		if not cible or not cible.Parent or not cible.Character then
			return false
		end

		local hrp = getCibleHRP(cible)
		if not hrp then
			task.wait(0.15)
			compteur = compteur + 1
			continue
		end

		if cibleSurSeat(cible) then
			return true
		end

		-- Re-check si assis ailleurs → abandon
		if estDejaAssis(cible) and not cibleSurSeat(cible) then
			setStatus(statusLabel, "🚫 " .. cible.Name .. " assis ailleurs. Abandon.", Color3.fromRGB(255, 80, 80))
			return false
		end

		if not couchEquipe() then
			equiperCouch()
			task.wait(0.03)
		end

		compteur = compteur + 1
		local pos = hrp.Position
		local myC = LocalPlayer.Character
		local myH = myC and myC:FindFirstChild("HumanoidRootPart")

		if myH then
			myH.CFrame = CFrame.new(pos)
		end

		local seats = trouverTousLesSeats()
		for i, seat in ipairs(seats) do
			local off = Vector3.new(0, -0.5 + (i - 1) * 0.15, 0)
			seat.CFrame = CFrame.new(pos + off)
		end

		local couch = getCouchTool()
		if couch then
			local handle = couch:FindFirstChild("Handle")
			if handle then
				handle.CFrame = CFrame.new(pos + Vector3.new(0, -0.5, 0))
			end
		end

		spamTool()

		if compteur % 10 == 0 then
			local d = string.rep(".", (compteur / 10) % 4)
			setStatus(statusLabel,
				"🔄 Spam " .. cible.Name .. d .. " #" .. compteur .. " | " .. #seats .. " seats",
				Color3.fromRGB(100, 200, 255)
			)
			setEtape(etapeLabel,
				"⚡ SPAM ACTIF\n"
				.. "━━━━━━━━━━━━━━━\n"
				.. "🎯 " .. cible.Name .. "\n"
				.. "📍 " .. math.floor(pos.X) .. "," .. math.floor(pos.Y) .. "," .. math.floor(pos.Z) .. "\n"
				.. "🔄 #" .. compteur .. " | 🪑 " .. #seats .. " seats\n"
				.. "⏳ Attente assise..."
			)
		end

		task.wait(CONFIG.SPAM_INTERVAL)
	end

	return false
end

------------------------------------------------------------
-- KILL UN JOUEUR (action complète)
------------------------------------------------------------

local function killJoueur(cible, statusLabel, etapeLabel)
	if not cible then return false end

	if estDejaAssis(cible) then
		setStatus(statusLabel, "🚫 " .. cible.Name .. " déjà assis. Skip.", Color3.fromRGB(255, 80, 80))
		setEtape(etapeLabel, "🚫 SKIP: " .. cible.Name .. " déjà assis")
		return false
	end

	-- GOODBYE
	if goodbyeActif then
		setStatus(statusLabel, "👋 Goodbye " .. cible.Name .. "...", Color3.fromRGB(255, 200, 100))
		setEtape(etapeLabel, "👋 GOODBYE\n━━━━━━━━━━━━━━━\n🎯 " .. cible.Name .. "\n👋 Wave + message...")
		faireGoodbye(cible)

		if stopAction then return false end

		-- Re-check après goodbye
		if estDejaAssis(cible) then
			setStatus(statusLabel, "🚫 " .. cible.Name .. " assis pendant goodbye.", Color3.fromRGB(255, 80, 80))
			return false
		end
	end

	-- Sauvegarder position
	local myC = LocalPlayer.Character
	if myC and myC:FindFirstChild("HumanoidRootPart") then
		positionInitiale = myC.HumanoidRootPart.Position
	end

	-- TP attente
	setStatus(statusLabel, "➡️ TP attente...", Color3.fromRGB(100, 200, 255))
	setEtape(etapeLabel, "📌 KILL: " .. cible.Name .. "\n━━━━━━━━━━━━━━━\n➡️ TP zone attente...")
	tp(CONFIG.COORD_ATTENTE)
	task.wait(0.4)

	if stopAction then
		if positionInitiale then tp(positionInitiale) end
		return false
	end

	-- Attendre Couch
	local t = 0
	while not avoirCouch() and t < 180 and not stopAction do
		task.wait(0.3)
		t = t + 0.3
		if math.floor(t) % 3 == 0 then
			setStatus(statusLabel, "⏳ Couch... " .. math.floor(t) .. "s", Color3.fromRGB(255, 200, 50))
		end

		if estDejaAssis(cible) then
			setStatus(statusLabel, "🚫 " .. cible.Name .. " assis. Abandon.", Color3.fromRGB(255, 80, 80))
			if positionInitiale then tp(positionInitiale) end
			return false
		end
	end

	if stopAction then
		if positionInitiale then tp(positionInitiale) end
		return false
	end

	if not avoirCouch() then
		setStatus(statusLabel, "❌ Timeout Couch", Color3.fromRGB(255, 50, 50))
		if positionInitiale then tp(positionInitiale) end
		return false
	end

	-- Équiper
	equiperCouch()
	task.wait(0.3)

	if estDejaAssis(cible) then
		desequiperCouch()
		if positionInitiale then tp(positionInitiale) end
		return false
	end

	-- Spam
	setStatus(statusLabel, "🔄 Spam sur " .. cible.Name .. "...", Color3.fromRGB(100, 200, 255))
	local ok = boucleSpam(cible, statusLabel, etapeLabel)

	if stopAction then
		desequiperCouch()
		if positionInitiale then tp(positionInitiale) end
		return false
	end

	if not ok then
		desequiperCouch()
		if positionInitiale then tp(positionInitiale) end
		return false
	end

	-- Assis! TP relâcher (COUCH EN MAIN)
	setStatus(statusLabel, "🪑 " .. cible.Name .. " ASSIS! TP relâche...", Color3.fromRGB(50, 255, 100))
	setEtape(etapeLabel,
		"✅ ASSIS!\n━━━━━━━━━━━━━━━\n🪑 " .. cible.Name .. " sur Couch\n➡️ TP relâche avec Couch..."
	)
	task.wait(0.2)
	tp(CONFIG.COORD_RELACHER)
	task.wait(0.4)

	-- MAINTENANT lâcher
	desequiperCouch()
	task.wait(0.3)

	setEtape(etapeLabel,
		"✅ KILL RÉUSSI\n━━━━━━━━━━━━━━━\n🎯 " .. cible.Name .. "\n📍 Relâché à: -337.55, 52.91, -454.94\n📦 Couch lâché"
	)

	-- Retour
	if positionInitiale then tp(positionInitiale) end
	task.wait(0.3)

	setStatus(statusLabel, "✅ " .. cible.Name .. " kill! ✓", Color3.fromRGB(50, 255, 50))
	return true
end

