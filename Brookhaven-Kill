	end)

	-- Toggle AutoKill
	autoKillBtn.MouseButton1Click:Connect(function()
		if not aLeGamepass and CONFIG.GAMEPASS_ID > 0 then
			afficherGamepassRequis()
			return
		end

		if autoKillActif then
			stopAutoKill = true
			autoKillActif = false
			autoKillBtn.Text = "🔄 AutoKill: OFF"
			autoKillBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 60)
			setStatus(statusLabel, "⛔ AutoKill OFF", Color3.fromRGB(200, 200, 200))
		else
			autoKillActif = true
			stopAutoKill = false
			stopAction = false
			autoKillBtn.Text = "🔄 AutoKill: ON"
			autoKillBtn.BackgroundColor3 = Color3.fromRGB(30, 80, 30)
			setStatus(statusLabel, "🔄 AutoKill ON!", Color3.fromRGB(255, 100, 50))

			task.spawn(function()
				autoKillLoop(statusLabel, etapeLabel)
				autoKillBtn.Text = "🔄 AutoKill: OFF"
				autoKillBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 60)
			end)
		end
	end)

	-- F6
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.F6 then
			if not aLeGamepass and CONFIG.GAMEPASS_ID > 0 then
				afficherGamepassRequis()
				return
			end
			mainFrame.Visible = not mainFrame.Visible
		end
	end)

	-- Joueurs join/leave
	Players.PlayerAdded:Connect(function()
		task.wait(1)
		rafraichirListe(scrollFrame, statusLabel)
	end)

	Players.PlayerRemoving:Connect(function(p)
		task.wait(0.3)
		joueursSelectionnes[p.Name] = nil
		rafraichirListe(scrollFrame, statusLabel)
	end)

	-- Auto refresh
	task.spawn(function()
		while true do
			task.wait(3)
			for _, child in ipairs(scrollFrame:GetChildren()) do
				if child:IsA("TextButton") and child.Name:sub(1, 2) == "P_" then
					local pN = child.Name:sub(3)
					local p = Players:FindFirstChild(pN)
					if p then
						local asi = estDejaAssis(p) and " 🪑" or " ✅"
						local sel = joueursSelectionnes[pN] and " ◄" or ""
						child.Text = "  👤 " .. p.DisplayName .. " (@" .. p.Name .. ")" .. asi .. sel
					end
				end
			end
		end
	end)

	-- Message initial
	if aLeGamepass or CONFIG.GAMEPASS_ID == 0 then
		setStatus(statusLabel, "✅ Panel v5 chargé! [F6] | Anti-AFK ✓", Color3.fromRGB(100, 255, 100))
	else
		setStatus(statusLabel, "🔒 Gamepass requis! Cliquez ⚡", Color3.fromRGB(255, 80, 80))
	end

	print("[ADMIN PANEL v5] Chargé! F6 pour ouvrir. Anti-AFK actif.")
end

